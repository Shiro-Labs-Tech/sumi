# Production (Vercel): connect a Neon Postgres database from the Vercel Marketplace; it sets DATABASE_URL for you.
DATABASE_URL=

# Required in production. 32+ random characters: openssl rand -base64 36
SESSION_SECRET=

# Creates the first owner when the staff table is empty. The owner must change this password at first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local only: SUMI_PGLITE=memory (or a folder path) runs an in-process Postgres, no database needed.
# npm run serve does this by default.
